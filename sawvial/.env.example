# NOTHING here is required. Defaults work; this file only lists what can be changed.
# To change a value: copy this file to ".env" in the project folder and edit the lines. There are NO API keys anywhere.

# --- hardware ---------------------------------------------------------------------------------------------------
# cuda = use the NVIDIA GPU and refuse to start on CPU by accident (default) | auto = GPU if available, else CPU | cpu
SAWVIAL_DEVICE=cuda

# --- models -----------------------------------------------------------------------------------------------------
SAWVIAL_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
SAWVIAL_ADAPTER=llm/sawvial-lora
SAWVIAL_TRANSLATOR_MODEL=facebook/nllb-200-distilled-600M
# 1 = never contact Hugging Face while running (models are downloaded once by tools/download_models.py)
SAWVIAL_OFFLINE=1

# --- data locations (relative to the project folder) --------------------------------------------------------------
SAWVIAL_DATASET_DIR=dataset
SAWVIAL_INDEX_DIR=index
SAWVIAL_RESEARCH_DIR=research_store

# --- which records may support an answer ----------------------------------------------------------------------------
SAWVIAL_ANSWERABLE_STATUSES=validated,verified

# --- retrieval / generation -----------------------------------------------------------------------------------------
SAWVIAL_TOP_K=4
SAWVIAL_MAX_NEW_TOKENS=300
SAWVIAL_MIN_RETRIEVAL_SCORE=0.03

# --- API protection ---------------------------------------------------------------------------------------------------
SAWVIAL_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SAWVIAL_RATE_LIMIT_PER_MIN=30

# --- online research (inside every chat answer when the local knowledge base is not enough) -----------------------------
# 1 = search online when local evidence is insufficient;  0 = local knowledge base only
SAWVIAL_ONLINE_RESEARCH=1
# key-less scholarly search: auto = OpenAlex + Crossref | openalex | crossref | none
SAWVIAL_SEARCH_PROVIDER=auto
# minimum trust of the FINAL site (after redirects): official | reputable | any
SAWVIAL_RESEARCH_MIN_TRUST=reputable
SAWVIAL_RESEARCH_MAX_DOCS=4
SAWVIAL_RESEARCH_TIME_BUDGET_S=60
SAWVIAL_RESEARCH_CACHE_DAYS=30
SAWVIAL_RESEARCH_HOST_DELAY_S=1.0
SAWVIAL_RESPECT_ROBOTS=1
SAWVIAL_FETCH_TIMEOUT_S=20
SAWVIAL_FETCH_MAX_MB=25
SAWVIAL_RESEARCH_MAX_PDF_PAGES=120
SAWVIAL_RESEARCH_ALLOWED_DOMAINS=
