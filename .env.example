# Copy to .env if you want to change defaults. SAWVIAL reads real environment variables;
# in PowerShell set them per session, e.g.   $env:SAWVIAL_OFFLINE = "0"
# There are NO secrets in this project. Never commit a real .env file.

# --- models --------------------------------------------------------------
SAWVIAL_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
SAWVIAL_ADAPTER=llm/sawvial-lora
SAWVIAL_TRANSLATOR_MODEL=facebook/nllb-200-distilled-600M
# 1 = never contact the Hugging Face hub while running (models must be pre-downloaded with tools/download_models.py)
SAWVIAL_OFFLINE=1

# --- data locations (relative to the project root) ---------------------------
SAWVIAL_DATASET_DIR=dataset
SAWVIAL_INDEX_DIR=index
SAWVIAL_RESEARCH_DIR=research_store

# --- which records may support an answer ---------------------------------------
# validated = automatic checks only; verified = human-approved. Adding needs_review lowers answer reliability.
SAWVIAL_ANSWERABLE_STATUSES=validated,verified

# --- retrieval / generation -----------------------------------------------------
SAWVIAL_TOP_K=4
SAWVIAL_MAX_NEW_TOKENS=300
SAWVIAL_MIN_RETRIEVAL_SCORE=0.03

# --- API protection --------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API. Default = local only.
# For a public deployment set your real https origin; never use "*".
SAWVIAL_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# requests per minute per client IP for /api/ask and /api/speech/stream (0 = off)
SAWVIAL_RATE_LIMIT_PER_MIN=30

# --- online research ---------------------------------------------------------------
# openalex | crossref | none   (key-less scholarly metadata APIs; "none" disables search)
SAWVIAL_SEARCH_PROVIDER=openalex
# optional: your email, sent to OpenAlex/Crossref as the polite-pool contact
SAWVIAL_CONTACT_EMAIL=
SAWVIAL_FETCH_TIMEOUT_S=20
SAWVIAL_FETCH_MAX_MB=25
SAWVIAL_RESEARCH_MAX_PDF_PAGES=120
# If set, research downloads are restricted to these domains (comma-separated, sub-domains included)
SAWVIAL_RESEARCH_ALLOWED_DOMAINS=
